// Beat 5 — user sessions impacted by the Internal Server Error during checkout.
// Shows session count, error distribution, and whether session replay is available.

fetch user.sessions, from: now()-24h, to: now()
| filter matchesPhrase(useraction.errors, "Internal Server Error")
| filter in(dt.entity.service, "SERVICE-531CE26849E95EC1", "SERVICE-5ACC60E0079F8E6D")
| summarize
    affected_sessions = count(),
    with_replay       = countIf(session.hasSessionReplay == true),
    by: bin(startTime, 30m)
| sort startTime desc
| limit 10
| fields startTime, affected_sessions, with_replay
