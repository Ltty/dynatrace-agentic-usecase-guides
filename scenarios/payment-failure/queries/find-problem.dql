// Resolver query: find the most recent payment-failure problem instance.
// Returns both ACTIVE and very-recent CLOSED instances (pattern fires on a schedule).
// The engine uses the result to derive PAYMENT_FAILURE_PROBLEM, TIMEFRAME_FROM, TIMEFRAME_TO.
//
// The pattern fires as a cluster of near-duplicate Davis problems (same root cause,
// overlapping windows, different affected-user counts). is_duplicate == false selects
// Davis's own merged/umbrella problem instead of one child duplicate picked arbitrarily.
// Do NOT filter on event.name — the umbrella problem is named "Multiple application
// problems" (it correlates payment, checkout, and the synthetic browser check), while
// "Failure rate increase" only matches the child records this filter is meant to collapse.

fetch dt.davis.problems, from: now()-48h, to: now()
| filter root_cause_entity_id == "SERVICE-531CE26849E95EC1"
| filter dt.davis.is_duplicate == false
| sort timestamp desc
| limit 1
| fields
    problem_id    = event.id,
    display_id    = display_id,
    status        = event.status,
    started       = event.start,
    ended         = event.end,
    affected_users = dt.davis.affected_users_count,
    root_cause    = root_cause_entity_name,
    description   = event.description
