// Beat 2 — deployment events correlated with the payment service failure.
// One row per commit: ArgoCD syncs one commit many times (once per resource), and a
// `sort desc | limit 5` hid the first sync at onset (testrun-08). Mirrors the DT skill.

fetch events, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter event.type == "CUSTOM_DEPLOYMENT"
| filter in(dt.entity.service, "SERVICE-531CE26849E95EC1", "SERVICE-5ACC60E0079F8E6D")
| summarize
    first_deploy = min(timestamp),
    deploys      = count(),
    services     = collectDistinct(dt.entity.service.name),
    by: { commit, git_url = gitUrl, owner, stage, app }
| sort first_deploy asc
