// Beat 2 — deployment events correlated with the payment service failure.
// ArgoCD sync events carry the git commit SHA directly — this is the "which
// commit do we revert" answer the source guide's beat 2 is built around.

fetch events, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter event.type == "CUSTOM_DEPLOYMENT"
| filter in(dt.entity.service, "SERVICE-531CE26849E95EC1", "SERVICE-5ACC60E0079F8E6D")
| sort timestamp desc
| limit 5
| fields
    timestamp,
    service     = dt.entity.service.name,
    commit,
    git_url     = gitUrl,
    stage,
    app,
    owner,
    deploy_name = event.name
