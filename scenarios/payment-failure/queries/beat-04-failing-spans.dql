// Beat 4 — exceptions on the payment service across the whole incident window.
// One row per distinct exception, oldest first; trace_id is the earliest failing trace for
// that message. Replaces the newest-5 sample, which showed the end of the incident, not the
// onset (testrun-08). Mirrors the DT skill.

fetch spans, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter dt.entity.service == "SERVICE-531CE26849E95EC1"
| filter request.is_failed == true
| expand span.events
| fieldsAdd
    exception_type = span.events[exception.type],
    exception_msg  = span.events[exception.message],
    exception_file = span.events[exception.file.full],
    exception_line = span.events[exception.line_number]
| filter isNotNull(exception_msg)
| sort start_time asc
| summarize
    failed_spans = count(),
    first_seen   = min(start_time),
    last_seen    = max(start_time),
    trace_id     = takeFirst(trace.id),
    by: { exception_type, exception_msg, exception_file, exception_line }
| sort first_seen asc
