// Beat 4 — failing traces on the Charge endpoint.
// Returns the exception type, message, and trace ID so the user can correlate
// to the specific code path introduced in the bad deployment.

fetch spans, from: now()-3h, to: now()
| filter dt.entity.service == "SERVICE-531CE26849E95EC1"
| filter endpoint.name == "Charge"
| filter span.status_code == "ERROR"
| sort timestamp desc
| limit 5
| fields
    timestamp,
    trace_id       = dt.trace_id,
    endpoint       = endpoint.name,
    status         = span.status_code,
    exception_type = `span.events[].exception.type`,
    exception_msg  = `span.events[].exception.message`,
    duration_ms    = round(span.duration / 1000000, 0)
