// Beat 4 — failing traces on the Charge endpoint.
// Returns the exception type, message, file and line so the user can correlate
// to the specific code path introduced in the bad deployment.
//
// Field notes (all verified live, none of these are documented defaults):
// - request.is_failed == true (not span.status_code == "ERROR" — that value
//   exists but is lowercase 'error', and is_failed is the more direct signal)
// - trace.id (not dt.trace_id), duration is a numeric-string (wrap in toDouble())
// - `expand span.events` does NOT flatten exception.* onto the row — the expanded
//   object stays nested; project its fields with bracket access:
//   span.events[exception.message], not exception.message directly.
// - round() needs a NAMED second argument: round(x, decimals: N).
//
// This incident can carry more than one distinct exception message on the same
// endpoint (e.g. a validation regression that rejects different card types
// differently) — don't assume the first row is the whole story; skim all 5.

fetch spans, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter dt.entity.service == "SERVICE-531CE26849E95EC1"
| filter request.is_failed == true
| sort start_time desc
| limit 5
| expand span.events
| fields
    start_time,
    trace_id       = trace.id,
    exception_type = span.events[exception.type],
    exception_msg  = span.events[exception.message],
    exception_file = span.events[exception.file.full],
    exception_line = span.events[exception.line_number],
    duration_ms    = round(toDouble(duration) / 1000000, decimals: 0)
