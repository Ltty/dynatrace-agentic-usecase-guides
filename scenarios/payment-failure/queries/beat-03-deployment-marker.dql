// Beat 3 supplement — deployment marker timestamps for the payment service.
// Paired with beat-03-service-failure-rate.dql to show the causal alignment.
//
// Returns ALL deployments in the incident window, not just the most recent — a `limit 1`
// with `sort desc` returns only the fix/rollback deploy, missing the culprit deploy that
// actually aligns with the failure-rate spike onset. This is a small result set (typically
// 2 rows: culprit + fix), so there's no need to pick one; let the engine correlate both
// against the timeline regardless of which order the beats run in.

fetch events, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter event.type == "CUSTOM_DEPLOYMENT"
| filter dt.entity.service == "SERVICE-531CE26849E95EC1"
| summarize timestamp = min(timestamp), by: { commit }
| sort timestamp asc
