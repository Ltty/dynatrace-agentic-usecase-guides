// Beat 3 supplement — deployment marker timestamp for the payment service.
// Paired with beat-03-service-failure-rate.dql to show the causal alignment.

fetch events, from: now()-24h, to: now()
| filter event.type == "CUSTOM_DEPLOYMENT"
| filter dt.entity.service == "SERVICE-531CE26849E95EC1"
| sort timestamp desc
| limit 1
| fields timestamp, version = dt.release_version, stage = dt.release_stage
