// Beat 4 (part 2) — full distributed trace waterfall for one representative failing
// request: frontend → checkout → payment, in call order. Answers "show me the trace"
// by revealing that everything upstream was clean and the fault is isolated to the
// payment Charge call.
//
// {{TRACE_ID}} is passed in as an ad-hoc var from beat-04-failing-spans.dql's result:
//   python tools/preflight.py run-query <id> <path> --var TRACE_ID=<value>
//
// trace.id is uid-typed — filter with toUid() or it silently matches nothing.
// Fetches ALL spans (no span.kind filter) so render_waterfall.py has the full
// parent-chain to nest correctly. The renderer collapses successful leaf siblings.

fetch spans, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter trace.id == toUid("{{TRACE_ID}}")
| sort start_time asc
| fields
    span.id,
    span.parent_id,
    start_time,
    service     = dt.service.name,
    span_name   = span.name,
    duration_ms = round(toDouble(duration) / 1000000, decimals: 2),
    failed      = request.is_failed,
    status      = span.status_code
