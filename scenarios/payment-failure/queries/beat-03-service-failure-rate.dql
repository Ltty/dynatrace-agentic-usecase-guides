// Beat 3 — service failure rate on the Charge endpoint over the problem window.
// Buckets into 5-minute intervals so the spike and the deployment marker align visually.

fetch spans, from: now()-3h, to: now()
| filter dt.entity.service == "SERVICE-531CE26849E95EC1"
| filter endpoint.name == "Charge"
| summarize
    total    = count(),
    failures = countIf(span.status_code == "ERROR"),
    by: bin(timestamp, 5m)
| fieldsAdd failure_rate_pct = round(toDouble(failures) / toDouble(total) * 100, 1)
| sort timestamp asc
| fields timestamp, total, failures, failure_rate_pct
