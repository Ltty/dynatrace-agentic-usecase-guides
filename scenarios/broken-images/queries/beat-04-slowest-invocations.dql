// Beat 4 (part 1) — the slowest Lambda invocations in the incident window. Picks the trace for
// beat-04-trace-waterfall.dql (chained: the trace_id of the first row is the waterfall's trace).
//
// This is a slowdown, not an outage: the Lambda invocations themselves are not marked failed, so
// do not filter on request.is_failed. Sort a computed duration_ms (duration is a numeric string).

fetch spans, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter dt.entity.service == "SERVICE-5A0CD2879D2F37BE"
| filter span.name == "Invoke lambda /images/presign."
| fieldsAdd duration_ms = round(toDouble(duration) / 1000000, decimals: 0)
| sort duration_ms desc
| limit 5
| fields start_time, trace_id = trace.id, duration_ms, failed = request.is_failed
