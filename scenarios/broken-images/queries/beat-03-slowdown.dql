// Beat 3 — what changed in the Lambda's behaviour: image resizes and request latency per 5 minutes.
//
// Before the regression deploy a resized image is served from S3, so the "Resize original product
// image" step never runs (resizes == 0). After it, every request resizes (resizes == requests) and
// the median invocation takes seconds. After the fix both fall back. The deploy timestamps from
// beat 2 land in the bucket where this flips.
//
// Spans expose start_time, not timestamp. duration is a numeric string: wrap it in toDouble().

fetch spans, from: "{{DQL_TIMEFRAME_FROM}}", to: "{{DQL_TIMEFRAME_TO}}"
| filter dt.entity.service == "SERVICE-5A0CD2879D2F37BE"
| filter in(span.name, "Invoke lambda /images/presign.", "Resize original product image")
| summarize
    requests = countIf(span.name == "Invoke lambda /images/presign."),
    resizes  = countIf(span.name == "Resize original product image"),
    p50_ms   = round(percentile(if(span.name == "Invoke lambda /images/presign.", toDouble(duration)), 50) / 1000000, decimals: 0),
    by: { bucket = bin(start_time, 5m) }
| sort bucket asc
