{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "dtctl *": "allow",
      "python tools/preflight.py*": "allow",
      "dtctl apply*": "deny",
      "dtctl create*": "deny",
      "dtctl edit*": "deny",
      "dtctl delete*": "deny",
      "dtctl restore*": "deny",
      "dtctl exec workflow*": "deny",
      "dtctl exec analyzer*": "deny",
      "dtctl auth logout*": "deny",
      "curl *": "deny"
    },
    "edit": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
