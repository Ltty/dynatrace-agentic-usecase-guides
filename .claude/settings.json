{
  "_comment": "Deny-by-default permission model for the Dynatrace Agentic Guides plugin. Only vetted read-only dtctl verbs are allowed. The guard_dtctl.py PreToolUse hook provides a second enforcement layer for Bash and PowerShell calls.",
  "permissions": {
    "allow": [
      "Bash(dtctl doctor*)",
      "Bash(dtctl query *)",
      "Bash(dtctl get *)",
      "Bash(dtctl describe *)",
      "Bash(dtctl describe-context *)",
      "Bash(dtctl inventory*)",
      "Bash(dtctl exec copilot*)",
      "Bash(dtctl config current-context*)",
      "Bash(dtctl config describe-context*)",
      "Bash(dtctl config get-contexts*)",
      "Bash(dtctl version*)",
      "Bash(dtctl commands*)",
      "Bash(dtctl auth status*)",
      "Bash(dtctl auth whoami*)",
      "Bash(python tools/preflight.py*)"
    ],
    "deny": [
      "Bash(dtctl apply*)",
      "Bash(dtctl create*)",
      "Bash(dtctl edit*)",
      "Bash(dtctl delete*)",
      "Bash(dtctl restore*)",
      "Bash(dtctl exec workflow*)",
      "Bash(dtctl exec analyzer*)",
      "Bash(curl *)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard_dtctl.py\""
          }
        ]
      }
    ]
  }
}
